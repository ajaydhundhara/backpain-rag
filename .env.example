# Copy to .env and fill in. .env is gitignored; this file is not.

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-key-here
# Writes the user-facing answer.
OPENAI_MODEL=gpt-4o-mini
# Intent classifier, reranker, HyDE and the gate-3 judges. High call volume: keep it cheap.
OPENAI_GUARD_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536

# Bump to rebuild the index without old cached answers leaking through.
INDEX_VERSION=v1

# --- Retrieval switches -------------------------------------------------------
# HYDE_ENABLED=true
# CORRECTIVE_ENABLED=true
# Gate 2 thresholds are normally set by `rag eval calibrate --write` (data/calibration.json).
# CONFIDENCE_THRESHOLD=7.5
# CORRECTIVE_THRESHOLD=6.0

# --- Cache (Redis / Upstash, optional) -----------------------------------------
# Unset = in-process cache only. Use the TCP (rediss://) endpoint, not REST.
# REDIS_URL=rediss://default:TOKEN@ENDPOINT.upstash.io:6379
REDIS_TIMEOUT_MS=400

# --- Accounts and history (optional) -------------------------------------------
# Setting DATABASE_URL turns on sign-up / sign-in and per-user history.
# Neon: use the *pooled* host (has "-pooler" in it). Supabase: the pooler on port 6543.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
#
# Without DATABASE_URL you can still force accounts on, backed by a local SQLite file
# (fine locally; on Vercel the file is discarded at every cold start):
# AUTH_ENABLED=true
# SQLITE_PATH=data/app.db

# REQUIRED for any real deployment. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# SESSION_SECRET=
SESSION_TTL_S=604800
HISTORY_MAX_ITEMS=200

# --- Spend control ---------------------------------------------------------------
# Questions per window, per account (or per IP when signed out). 0 disables.
# One question can cost: intent + embedding + HyDE + rerank batch(es) + answer + 2 judges.
RATE_LIMIT_PER_WINDOW=5
RATE_LIMIT_WINDOW_S=3600
# Sign-in / sign-up attempts per IP per window (separate bucket).
AUTH_RATE_LIMIT_PER_WINDOW=20
# Read the client IP from x-forwarded-for. Correct behind Vercel; turn off if exposed directly.
TRUST_PROXY_HEADER=true

# --- Email: verification + password reset (Amazon SES over SMTP, optional) -------
# Setting SES_SMTP_HOST and MAIL_FROM turns on email verification and password reset.
# Credentials: SES console -> SMTP settings -> Create SMTP credentials (NOT your AWS keys).
# New SES accounts are sandboxed: they only deliver to verified addresses.
# SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
# SES_SMTP_USER=AKIA...
# SES_SMTP_PASSWORD=
# MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=Back Pain Help
# Absolute base for links in emails. Set it for any real deployment.
# PUBLIC_BASE_URL=https://your-app.vercel.app
